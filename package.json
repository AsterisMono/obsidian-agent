{
  "name": "obsidian-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "build:link": "node scripts/build-and-link.ts",
    "check": "pnpm run check:format && pnpm run check:lint && pnpm run check:types && pnpm run check:actionlint && pnpm run check:lean",
    "check:actionlint": "actionlint",
    "check:format": "prettier --check .",
    "check:lean": "node scripts/check-lean.ts",
    "check:lint": "eslint .",
    "check:types": "tsc --noEmit && tsc --noEmit --project .agents/skills/obsidian-computer-use/tsconfig.json",
    "dev": "node esbuild.config.mjs",
    "fixtures:lean": "node scripts/check-lean.ts --write-fixtures",
    "format": "prettier --write .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm run test:tooling && pnpm run test:e2e",
    "test:e2e": "node esbuild.config.mjs production && node --test --test-concurrency=1 tests/e2e/*.test.ts",
    "test:tooling": "node esbuild.config.mjs production && node --test --test-concurrency=1 tests/tooling/*.test.ts",
    "vision": "node scripts/vision-run.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.0",
    "@earendil-works/pi-ai": "0.87.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.25.12",
    "eslint": "^10.11.0",
    "obsidian": "1.13.1",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
