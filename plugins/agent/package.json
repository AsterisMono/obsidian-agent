{
  "name": "obsidian-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "build:link": "node scripts/build-and-link.ts",
    "check": "tsc --noEmit && pnpm run check:lean",
    "check:lean": "node scripts/check-lean.ts",
    "fixtures:lean": "node scripts/check-lean.ts --write-fixtures",
    "test": "node esbuild.config.mjs production && node --test --test-concurrency=1 tests/e2e/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.0",
    "@earendil-works/pi-ai": "0.87.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.25.12",
    "obsidian": "1.13.1",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3"
  }
}
